# Скопируйте в .env и подставьте свой ключ.
# .env в .gitignore и в репозиторий не попадёт.
OPENROUTER_API_KEY=sk-or-v1-...

# Необязательно: заголовки атрибуции OpenRouter
# OPENROUTER_SITE_URL=http://127.0.0.1:8000
# OPENROUTER_SITE_NAME=ai-challenge-bench

# Необязательно: где лежит база с историей диалогов.
# По умолчанию data/agents.db в корне ветки. Проверки задают свой путь,
# чтобы не писать в рабочий файл.
# AGENT_DB_PATH=data/agents.db
